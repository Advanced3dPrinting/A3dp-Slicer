#!/bin/bash

#
# This script can download and compile dependencies, compile SuperSlicer
# and optional build a .tgz and an appimage.
#
# Original script from SuperSlicer by supermerill https://github.com/supermerill/SuperSlicer
#
# Change log:
#
# 20 Nov 2023, wschadow, branding and minor changes
# 01 Jan 2024, wschadow, added build options
#

# Our sysctl call may be run as normal user,
# but /sbin is not always in normal users' PATH.
if [[ -f /sbin/sysctl && -x /sbin/sysctl ]]; then sysctl_bin=/sbin/sysctl
else sysctl_bin=sysctl  # If not found in sbin, hope
fi

export ROOT=`pwd`
export NCORES=`nproc`

VERSION_NUMBER=""
GTK_VERSION=3
while getopts ":iagvhg:" opt; do
  case ${opt} in
    i )
        export BUILD_IMAGE="1"
        ;;
    a )
        export BUILD_APP="1"
        ;;
    g )
        GTK_VERSION=2
        ;;
    v )
        export VERSION_NUMBER="-@SLIC3R_VERSION_FULL@"
        ;;
    h ) echo "Usage: ./BuildLinuxImage.sh [-g][-i][-a][-h]"
        echo "   -g: force gtk2 build"
        echo "   -i: generate .tgz and Appimage (optional)"
        echo "   -a: generate app (optional)"
        echo "   -v: with version number (optional)"
        echo "   -h: help"
        exit 0
        ;;
  esac
done

if [[ -n "$BUILD_APP" ]]
then
    echo -e "\n[7/8] Generating Linux app ..."
    # create directory and copy into it
    if [ -d "package" ]
    then
        rm -rf package/*
        rm -rf package/.* 2&>/dev/null
    else
        mkdir package
    fi
    mkdir package/bin

    # copy Resources
    cp -rf ../resources/ package/resources
    cp -f bin/@SLIC3R_APP_CMD@ package/bin/@SLIC3R_APP_CMD@
    cp -f src/OCCTWrapper.so package/bin    
    ln -rs package/bin/@SLIC3R_APP_CMD@ package/bin/@GCODEVIEWER_APP_CMD@
    # remove unneeded po from resources
    find package/resources/localization -name "*.po" -type f -delete
    find package/resources/localization -name "*.pot" -type f -delete
    find package/resources/localization -name "*.ini" -type f -delete
    find package/resources/localization -name "*.py" -type f -delete
    find package/resources/localization -name "*.md" -type f -delete
    find package/resources/localization -name "*.txt" -type f -delete
    find package/resources/localization -name "*database*" -type f -delete
    find package/resources/localization -name "Slic3r.mo" -type f -delete
    
    #copy distant profiles
    python ../src/platform/download_vendor_bundles.py package/resources

    # copy occtwrapper
    cp src/OCCTWrapper.so package/bin/OCCTWrapper.so

    # create bin
    # usr/lib holds the bundled non-glibc libraries (see build_appimage.sh);
    # including it in LD_LIBRARY_PATH is belt-and-suspenders on top of DT_RPATH.
    # Launcher wrappers: set the bundle library path, cd into the AppDir
    # (WebKit's baked helper path was rewritten to be CWD-relative - see
    # build_appimage.sh) and point WebKit/GIO at the bundled pieces.
    cat > package/@SLIC3R_APP_CMD@ <<'LAUNCHER_EOF'
#!/bin/bash
DIR=$(readlink -f "$0" | xargs dirname)
cd "$DIR"
export LD_LIBRARY_PATH="$DIR/bin:$DIR/usr/lib"
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
for d in "$DIR"/usr/lib/webkit2gtk-*; do
    [ -d "$d/injected-bundle" ] && export WEBKIT_INJECTED_BUNDLE_PATH="$d/injected-bundle"
done
[ -d "$DIR/usr/lib/gio/modules" ] && export GIO_MODULE_DIR="$DIR/usr/lib/gio/modules"
exec "$DIR/bin/@SLIC3R_APP_CMD@" "$@"
LAUNCHER_EOF
    chmod ug+x package/@SLIC3R_APP_CMD@
    cat > package/@GCODEVIEWER_APP_CMD@ <<'LAUNCHER_EOF'
#!/bin/bash
DIR=$(readlink -f "$0" | xargs dirname)
cd "$DIR"
export LD_LIBRARY_PATH="$DIR/bin:$DIR/usr/lib"
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
for d in "$DIR"/usr/lib/webkit2gtk-*; do
    [ -d "$d/injected-bundle" ] && export WEBKIT_INJECTED_BUNDLE_PATH="$d/injected-bundle"
done
[ -d "$DIR/usr/lib/gio/modules" ] && export GIO_MODULE_DIR="$DIR/usr/lib/gio/modules"
exec "$DIR/bin/@GCODEVIEWER_APP_CMD@" "$@"
LAUNCHER_EOF
    chmod ug+x package/@GCODEVIEWER_APP_CMD@
    echo -e "\n... done\n"
fi

if [[ -n "$BUILD_IMAGE" ]]
then
    echo -e "\n[8/8] Creating .tgz and Appimage for distribution ...\n"

    pushd package > /dev/null
    # Build the AppImage FIRST: it bundles every non-glibc library into
    # usr/lib/ and rpaths the binaries. The .tgz is then cut from the same
    # bundled tree, so both artifacts are standalone.
    chmod +x ../src/build_appimage.sh
    ../src/build_appimage.sh

    if [[ "$GTK_VERSION" == 2 ]]
    then
       echo -e "\ntaring for gtk2..."
       tar -czf ../@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK2.tgz @SLIC3R_APP_CMD@ @GCODEVIEWER_APP_CMD@ bin resources usr
    elif [[ "$GTK_VERSION" == 3 ]]
    then
       echo -e "\ntaring for gtk3..."
       tar -czf ../@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK3.tgz @SLIC3R_APP_CMD@ @GCODEVIEWER_APP_CMD@ bin resources usr
    else
        echo -e "\nError, only GTK2 and GTK3 verison are supported. Asked GTK version: '$GTK_VERSION'\n"
    fi

    echo "> ls package/.."
    ls -al ..
    echo "> ls package/../src"
    ls -al ../src
    echo "> ls -al ROOT(build)/bin"
    ls -al $ROOT/bin
    echo "> ls -al ROOT(build)/src"
    ls -al $ROOT/src
    popd  > /dev/null
    if [[ "$GTK_VERSION" == 2 ]]
    then
        echo -e "\npackaging gtk2..."
        mv package/"@SLIC3R_APP_KEY@_ubu64.AppImage" "@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK2.AppImage"
    elif [[ "$GTK_VERSION" == 3 ]]
    then
        echo -e "\npackaging gtk3..."
        mv package/"@SLIC3R_APP_KEY@_ubu64.AppImage" "@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK3.AppImage"
    else
        echo -e "\nError, only GTK2 and GTK3 verison are supported. Asked GTK version: '$GTK_VERSION'\n"
    fi
    echo -e "\n... done\n"
fi
